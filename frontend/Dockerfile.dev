# PointQR Frontend – Vite Dev Server
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9

# Copy manifests and install all dependencies.
# Dev dockerfile intentionally omits --frozen-lockfile so that packages
# added to package.json (e.g. tailwindcss) are installed even when the
# lockfile hasn't been regenerated on the host yet.
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

# Copy source (overridden by volume mount in dev)
COPY . .

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
