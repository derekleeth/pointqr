# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for shell scripts and Docker files
*.sh text eol=lf
Dockerfile* text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.mako text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
