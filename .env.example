# =============================================================================
# PointQR – Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=pointqr
POSTGRES_PASSWORD=pointqr_dev_password
POSTGRES_DB=pointqr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async DSN (used by FastAPI & Alembic)
DATABASE_URL=postgresql+asyncpg://pointqr:pointqr_dev_password@postgres:5432/pointqr
# Sync DSN (used by Alembic migrations only, if needed)
DATABASE_SYNC_URL=postgresql+psycopg2://pointqr:pointqr_dev_password@postgres:5432/pointqr

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=pointqr
RABBITMQ_DEFAULT_PASS=pointqr_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Full AMQP URL (used by Celery)
CELERY_BROKER_URL=amqp://pointqr:pointqr_dev_password@rabbitmq:5672//

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Absolute path inside the container (mapped to a Docker volume on the host)
STORAGE_PATH=/app/storage

# -----------------------------------------------------------------------------
# Email (MailHog for local dev)
# -----------------------------------------------------------------------------
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@pointqr.dev
MAIL_TLS=false
MAIL_SSL=false

# -----------------------------------------------------------------------------
# GeoIP (Phase 3 – leave blank for Phase 1)
# -----------------------------------------------------------------------------
GEOIP_DB_PATH=/app/storage/GeoLite2-City.mmdb

# -----------------------------------------------------------------------------
# Rate Limiting (Phase 5 – leave defaults for Phase 1)
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

